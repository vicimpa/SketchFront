{
	"name": "sketchfront",
	"private": true,
	"version": "0.0.0",
	"description": "Browser multiplayer shooter built on the Sketchbook sandbox (three.js + cannon-es)",
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"packages/shared",
		"packages/client",
		"packages/server"
	],
	"scripts": {
		"dev": "npm run dev -w @sketchfront/client",
		"build": "npm run build -w @sketchfront/client",
		"preview": "npm run preview -w @sketchfront/client",
		"server": "npm run start -w @sketchfront/server",
		"typecheck": "npm run typecheck --workspaces --if-present"
	},
	"engines": {
		"node": ">=22.18"
	},
	"devDependencies": {
		"typescript": "~5.9.3"
	}
}
